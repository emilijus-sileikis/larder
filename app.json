{
  "expo": {
    "name": "Larder",
    "slug": "larder",
    "owner": "emilijus",
    "scheme": "larder",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF7F2",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emilijussileikis.larder"
    },
    "android": {
      "package": "com.emilijussileikis.larder",
      "adaptiveIcon": {
        "backgroundColor": "#4A7C59",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Larder to pick recipe photos from your photo library.",
          "cameraPermission": "Allow Larder to take photos of your recipes."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Larder to scan pantry product barcodes with your camera."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4A7C59"
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": ["text/*"]
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2a1cea4a-480d-4bea-a7db-0777c4e4769e"
      }
    }
  }
}
